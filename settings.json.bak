// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
    "auto_update_extensions": {
        "php": false
    },
    "cli_default_open_behavior": "existing_window",
    "diff_view_style": "split",
    "project_panel": {
        "dock": "left"
    },
    "outline_panel": {
        "dock": "left"
    },
    "collaboration_panel": {
        "dock": "left"
    },
    "git_panel": {
        "dock": "right"
    },
    "thread_panel": {
        "dock": "right"
    },
    "edit_predictions": {
        "mode": "subtle",
        "provider": "zed"
    },
    "agent_servers": {
        "mistral-vibe": {
            "default_config_options": {
                "model": "devstral-2"
            },
            "type": "registry"
        },
        "claude-acp": {
            "type": "registry"
        }
    },
    "agent": {
        "dock": "right",
        "sidebar_side": "right",
        "inline_assistant_model": {
            "provider": "mistral",
            "model": "devstral-medium-latest",
            "enable_thinking": false
        },
        "default_model": {
            "provider": "mistral",
            "model": "devstral-medium-latest"
        },
        "favorite_models": [
            {
                "provider": "anthropic",
                "model": "claude-4-6-sonnet-latest"
            },
            {
                "provider": "anthropic",
                "model": "claude-4-6-opus-latest"
            }
        ],
        "model_parameters": []
    },
    "language_models": {
        "openai_compatible": {
            "Synthetic": {
                "api_url": "https://api.synthetic.new/openai/v1",
                "available_models": [
                    {
                        "name": "hf:moonshotai/Kimi-K2.5",
                        "max_tokens": 200000,
                        "max_output_tokens": 32000,
                        "max_completion_tokens": 200000,
                        "capabilities": {
                            "tools": true,
                            "images": true,
                            "parallel_tool_calls": false,
                            "prompt_cache_key": false,
                            "chat_completions": true
                        }
                    }
                ]
            }
        }
    },
    "wsl_connections": [
        {
            "distro_name": "Ubuntu-bkaplan",
            "user": null,
            "projects": [
                {
                    "paths": ["/home/bkaplan/IFT-REPOS/WORKSPACE/jarvis2-front"]
                },
                {
                    "paths": ["/home/bkaplan/IFT-REPOS/WORKSPACE/offre_activee"]
                },
                {
                    "paths": ["/home/bkaplan/WORKSPACE"]
                },
                {
                    "paths": [
                        "/home/bkaplan/WORKSPACE/IFT-REPOS/python-scripts/./"
                    ]
                },
                {
                    "paths": [
                        "/home/bkaplan/WORKSPACE/IFT-REPOS/rabbitmq-workers-offre-activee"
                    ]
                }
            ]
        }
    ],
    "telemetry": {
        "diagnostics": true,
        "metrics": false
    },
    "session": {
        "trust_all_worktrees": true
    },
    "vim_mode": true,
    "use_on_type_format": false,
    "format_on_save": "on",
    "relative_line_numbers": "disabled",
    "icon_theme": {
        "mode": "system",
        "light": "Zed (Default)",
        "dark": "Colored Zed Icons Theme Dark"
    },
    "ui_font_size": 16,
    "buffer_font_size": 15,
    "theme": {
        "mode": "dark",
        "light": "Ayu Light",
        "dark": "Ayu Dark"
    },
    "experimental.theme_overrides": {
        "tab.active_background": "#6d0000"
    },
    "preview_tabs": {
        "enable_preview_from_multibuffer": false,
        "enable_preview_file_from_code_navigation": false
    },
    "languages": {
        "YAML": {
            "tab_size": 2
        }
    },
    "tabs": {
        "file_icons": true
    }
}
